# Flask Configuration
SECRET_KEY=change-this-to-a-long-random-secret-key
FLASK_ENV=development
FLASK_APP=run.py

# Database
# SQLite (default for development — no setup required):
DATABASE_URL=sqlite:///dev.db
# MySQL (for production):
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/it_support_db

# Google OAuth 2.0
# 1. Go to https://console.cloud.google.com/
# 2. APIs & Services > Credentials > Create OAuth 2.0 Client ID
# 3. Add redirect URI: http://localhost:5000/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Required for local HTTP development (remove in production):
OAUTHLIB_INSECURE_TRANSPORT=1

# Critical incident email alerts
# Sends an email when a new incident is recorded with INCIDENT_ALERT_SEVERITY.
EMAIL_ALERTS_ENABLED=1
INCIDENT_ALERT_SEVERITY=critical
INCIDENT_ALERT_EMAIL_TO=allayedicko4@gmail.com

# Email transport
# Use EMAIL_TRANSPORT=auto to prefer SendGrid, then Resend, then SMTP.
EMAIL_TRANSPORT=auto

# SendGrid HTTP API settings (simplest hosted option: supports single sender verification)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=your-verified-sender@example.com

# Resend HTTP API settings (recommended for Render / deployed environments)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=alerts@your-domain.com

# SMTP settings (fallback for local/dev environments)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=1
SMTP_USERNAME=your-sender@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=your-sender@gmail.com
